<svg x="0" y="195" width="180" height="180">
    <rect x="0" y="0" width="180" height="180" fill="transparent"/>
    <g style="margin: auto" transform="translate({{OP_Translate}} 0)" >
        <text class="{{color2}} sharpGroteskBold15" id="text50" x="100" y="100" text-anchor="end"
            style="font-size:90px">{{oldPriceDigits}}
        </text>
        <svg x="100" y="25" width="50" height="80">
            <rect x="0" y="0" width="50" height="80" fill="transparent"/>
            <text class="{{color2}} sharpGroteskBold15" style="font-size: 45px" x="0" y="40" id="text52">€</text>
            <text class="{{color2}} sharpGroteskBold15" style="font-size: 45px" x="0" y="75"
                id="text54">{{oldPriceDecimal}}</text>

        </svg>
    </g>

    <svg x="0" y="100" width="180" height="30">
        <rect x="0" y="0" width="180" height="30" fill="transparent"/>
        <text class="{{color2}} sharpGroteskBold15" x="50%" y="25" text-anchor="middle"
            style="font-size:22px">{{textBelowOldPrice}}</text>
    </svg>

</svg>
{{#if crossed}}
<line style="fill:none;stroke-width:7.41279984" class="st20 {{crossColor}}" x1="15" y1="320" x2="115" y2="205"
    id="line863" />
{{/if}}
