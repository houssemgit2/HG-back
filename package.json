{
  "name": "back-v2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "copy-assets": "cpx 'libs/pdf-promo-generator/resources/**' 'dist/resources'",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "prestart": "yarn copy-assets",
    "prestart:dev": "yarn copy-assets",
    "prestart:prod": "yarn build && yarn copy-assets",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^7.0.0",
    "@nestjs/config": "^0.4.0",
    "@nestjs/core": "^7.0.0",
    "@nestjs/jwt": "^7.0.0",
    "@nestjs/passport": "^7.0.0",
    "@nestjs/platform-express": "^7.0.0",
    "@nestjs/schedule": "^0.4.0",
    "@nestjs/swagger": "^4.5.1",
    "@nestjs/typeorm": "^7.0.0",
    "@types/express-handlebars": "^3.1.0",
    "@types/pdfkit": "^0.10.5",
    "@types/pdfmake": "^0.1.13",
    "@types/uuid": "^7.0.2",
    "archiver": "^4.0.1",
    "aws-sdk": "^2.664.0",
    "bcrypt": "^4.0.1",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.11.1",
    "cpx": "^1.5.0",
    "dotenv": "^8.2.0",
    "generate-password": "^1.5.1",
    "group-array-items": "^1.0.6",
    "handlebars": "^4.7.6",
    "helmet": "^3.22.0",
    "lodash": "^4.17.15",
    "mime-types": "^2.1.27",
    "moment": "^2.24.0",
    "multer": "^1.4.2",
    "multer-s3": "^2.9.0",
    "mysql": "^2.18.1",
    "nest-emitter": "^1.1.0",
    "node-gyp": "^6.1.0",
    "node-xlsx": "^0.15.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "pdfmake": "^0.1.65",
    "promise-all-settled": "^1.1.0",
    "reflect-metadata": "^0.1.13",
    "request-promise": "^4.2.5",
    "rimraf": "^3.0.2",
    "rxjs": "^6.5.4",
    "snakecase-keys": "^3.2.0",
    "svg-to-pdfkit": "^0.1.8",
    "swagger-ui-express": "^4.1.4",
    "typeorm": "^0.2.24",
    "typeorm-upsert": "^1.0.0",
    "url-parse": "^1.4.7",
    "uuid": "^7.0.3",
    "xlsx": "^0.16.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.0.0",
    "@nestjs/schematics": "^7.0.0",
    "@nestjs/testing": "^7.0.0",
    "@types/express": "^4.17.3",
    "@types/jest": "25.1.4",
    "@types/node": "^13.11.1",
    "@types/passport-jwt": "^3.0.3",
    "@types/supertest": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^2.23.0",
    "@typescript-eslint/parser": "^2.23.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-plugin-import": "^2.20.1",
    "jest": "^25.1.0",
    "prettier": "^1.19.1",
    "supertest": "^4.0.2",
    "ts-jest": "25.2.1",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.6.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "@app/pdf-promo-generator/(.*)": "<rootDir>/libs/pdf-promo-generator/src/$1",
      "@app/pdf-promo-generator": "<rootDir>/libs/pdf-promo-generator/src",
      "@app/pdf-calendar-generator/(.*)": "<rootDir>/libs/pdf-calendar-generator/src/$1",
      "@app/pdf-calendar-generator": "<rootDir>/libs/pdf-calendar-generator/src"
    }
  }
}
