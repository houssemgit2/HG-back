{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "paths": {
      "@app/pdf-promo-generator": ["libs/pdf-promo-generator/src"],
      "@app/pdf-promo-generator/*": ["libs/pdf-promo-generator/src/*"],
      "@app/pdf-calendar-generator": ["libs/pdf-calendar-generator/src"],
      "@app/pdf-calendar-generator/*": ["libs/pdf-calendar-generator/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
